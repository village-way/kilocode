{
  "name": "zhanlu",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "7.0.47",
  "icon": "assets/icons/icon.png",
  "galleryBanner": {
    "color": "#617A91",
    "theme": "dark"
  },
  "publisher": "ecloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/village-way/zhanlu-vs.git",
    "directory": "packages/kilo-vscode"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "author": {
    "name": "ecloud"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "ai",
    "湛卢",
    "ecloud",
    "移动云",
    "AI编程",
    "coding",
    "agent",
    "autonomous",
    "chatgpt",
    "claude",
    "zhanlu",
    "mcp"
  ],
  "activationEvents": [
    "onWebviewPanel:zhanlu.AgentManagerPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zhanlu-sidebar",
          "title": "%views.activitybar.title%",
          "icon": "assets/icons/icon.svg",
          "darkIcon": "assets/icons/icon.svg"
        }
      ]
    },
    "views": {
      "zhanlu-sidebar": [
        {
          "type": "webview",
          "id": "zhanlu.sidebarView",
          "name": "%views.sidebar.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "zhanlu.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "zhanlu.agentManagerOpen",
        "title": "Agent Manager",
        "icon": "$(circuit-board)"
      },
      {
        "command": "zhanlu.marketplaceButtonClicked",
        "title": "Marketplace",
        "icon": "$(extensions)"
      },
      {
        "command": "zhanlu.historyButtonClicked",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "zhanlu.cloudHistoryButtonClicked",
        "title": "Cloud History",
        "icon": "$(cloud)"
      },
      {
        "command": "zhanlu.profileButtonClicked",
        "title": "Profile",
        "icon": "$(account)"
      },
      {
        "command": "zhanlu.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "zhanlu.openInTab",
        "title": "湛卢",
        "icon": {
          "light": "assets/icons/icon.svg",
          "dark": "assets/icons/icon.svg"
        }
      },
      {
        "command": "zhanlu.showChanges",
        "title": "Show Changes",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.openMigrationWizard",
        "title": "Migrate Settings from Legacy Version",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.autocomplete.generateSuggestions",
        "title": "Generate Suggested Edits",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.previousSession",
        "title": "Agent Manager: Previous Session",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.nextSession",
        "title": "Agent Manager: Next Session",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.previousTab",
        "title": "Agent Manager: Previous Tab",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.nextTab",
        "title": "Agent Manager: Next Tab",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "湛卢",
        "icon": "$(terminal)"
      },
      {
        "command": "zhanlu.agentManager.toggleDiff",
        "title": "Agent Manager: Toggle Diff Panel",
        "category": "湛卢",
        "icon": "$(diff)"
      },
      {
        "command": "zhanlu.agentManager.showShortcuts",
        "title": "Agent Manager: Show Keyboard Shortcuts",
        "category": "湛卢",
        "icon": "$(keyboard)"
      },
      {
        "command": "zhanlu.agentManager.focusPanel",
        "title": "Agent Manager: Focus Panel",
        "category": "湛卢",
        "icon": "$(circuit-board)"
      },
      {
        "command": "zhanlu.agentManager.newTab",
        "title": "Agent Manager: New Tab",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.closeTab",
        "title": "Agent Manager: Close Tab",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.newWorktree",
        "title": "Agent Manager: New Worktree",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.openWorktree",
        "title": "Agent Manager: Open Worktree",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.closeWorktree",
        "title": "Agent Manager: Close Worktree",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.advancedWorktree",
        "title": "Agent Manager: Advanced New Worktree",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.jumpTo1",
        "title": "Agent Manager: Jump to Item 1",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.jumpTo2",
        "title": "Agent Manager: Jump to Item 2",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.jumpTo3",
        "title": "Agent Manager: Jump to Item 3",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.jumpTo4",
        "title": "Agent Manager: Jump to Item 4",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.jumpTo5",
        "title": "Agent Manager: Jump to Item 5",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.jumpTo6",
        "title": "Agent Manager: Jump to Item 6",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.jumpTo7",
        "title": "Agent Manager: Jump to Item 7",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.jumpTo8",
        "title": "Agent Manager: Jump to Item 8",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.agentManager.jumpTo9",
        "title": "Agent Manager: Jump to Item 9",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "湛卢",
        "icon": {
          "light": "assets/icons/icon.svg",
          "dark": "assets/icons/icon.svg"
        }
      },
      {
        "command": "zhanlu.explainCode",
        "title": "Explain Code",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.fixCode",
        "title": "Fix Code",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.improveCode",
        "title": "Improve Code",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.addToContext",
        "title": "Add to Context",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.terminalAddToContext",
        "title": "Add Terminal Content to Context",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.terminalFixCommand",
        "title": "Fix This Command",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.terminalExplainCommand",
        "title": "Explain This Command",
        "category": "湛卢"
      },
      {
        "command": "zhanlu.focusChatInput",
        "title": "Focus Chat Input",
        "category": "湛卢"
      }
    ],
    "submenus": [
      {
        "id": "zhanlu.editorContextMenu",
        "label": "湛卢"
      },
      {
        "id": "zhanlu.terminalContextMenu",
        "label": "湛卢"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zhanlu.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == zhanlu.sidebarView"
        },
        {
          "command": "zhanlu.agentManagerOpen",
          "group": "navigation@1",
          "when": "view == zhanlu.sidebarView"
        },
        {
          "command": "zhanlu.marketplaceButtonClicked",
          "group": "navigation@2",
          "when": "view == zhanlu.sidebarView"
        },
        {
          "command": "zhanlu.cloudHistoryButtonClicked",
          "group": "navigation@3",
          "when": "view == zhanlu.sidebarView"
        },
        {
          "command": "zhanlu.historyButtonClicked",
          "group": "navigation@4",
          "when": "view == zhanlu.sidebarView"
        },
        {
          "command": "zhanlu.profileButtonClicked",
          "group": "navigation@5",
          "when": "view == zhanlu.sidebarView"
        },
        {
          "command": "zhanlu.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == zhanlu.sidebarView"
        }
      ],
      "scm/title": [
        {
          "command": "zhanlu.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "zhanlu.openInTab",
          "group": "navigation",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "submenu": "zhanlu.editorContextMenu",
          "group": "1_zhanlu"
        }
      ],
      "zhanlu.editorContextMenu": [
        {
          "command": "zhanlu.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "zhanlu.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "zhanlu.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "zhanlu.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "zhanlu.terminalContextMenu",
          "group": "2_zhanlu"
        }
      ],
      "zhanlu.terminalContextMenu": [
        {
          "command": "zhanlu.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "zhanlu.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "zhanlu.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zhanlu.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "zhanlu.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "zhanlu.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "zhanlu.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.focusPanel",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "terminalFocus && zhanlu.agentTerminalFocus"
      },
      {
        "command": "zhanlu.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.advancedWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      },
      {
        "command": "zhanlu.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'zhanlu.AgentManagerPanel'"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "zhanlu.language": {
          "type": "string",
          "default": "",
          "description": "Override the UI language for 湛卢 (e.g. en, de, ja). Empty means use VS Code's display language.",
          "enum": [
            "",
            "en",
            "zh",
            "zht",
            "ko",
            "de",
            "es",
            "fr",
            "da",
            "ja",
            "pl",
            "ru",
            "ar",
            "no",
            "br",
            "th",
            "bs"
          ],
          "enumDescriptions": [
            "Auto (VS Code language)",
            "English",
            "简体中文",
            "繁體中文",
            "한국어",
            "Deutsch",
            "Español",
            "Français",
            "Dansk",
            "日本語",
            "Polski",
            "Русский",
            "العربية",
            "Norsk",
            "Português (Brasil)",
            "ภาษาไทย",
            "Bosanski"
          ]
        },
        "zhanlu.model.providerID": {
          "type": "string",
          "default": "kilo",
          "description": "Default model provider ID for new sessions"
        },
        "zhanlu.model.modelID": {
          "type": "string",
          "default": "kilo-auto/free",
          "description": "Default model ID for new sessions"
        },
        "zhanlu.autocomplete.enableAutoTrigger": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic inline completion suggestions"
        },
        "zhanlu.autocomplete.enableSmartInlineTaskKeybinding": {
          "type": "boolean",
          "default": false,
          "description": "Enable smart inline task keybinding"
        },
        "zhanlu.autocomplete.enableChatAutocomplete": {
          "type": "boolean",
          "default": false,
          "description": "Enable chat textarea autocomplete"
        },
        "zhanlu.browserAutomation.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable browser automation powered by Playwright. When enabled, the AI agent can interact with web pages in a visible Chrome window."
        },
        "zhanlu.browserAutomation.useSystemChrome": {
          "type": "boolean",
          "default": true,
          "description": "Use your system's installed Chrome browser instead of downloading a separate Chromium instance."
        },
        "zhanlu.browserAutomation.headless": {
          "type": "boolean",
          "default": false,
          "description": "Run browser automation in headless mode (no visible window). When disabled, you can watch the agent interact with the browser."
        },
        "zhanlu.notifications.agent": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when agent completes a task"
        },
        "zhanlu.notifications.permissions": {
          "type": "boolean",
          "default": true,
          "description": "Show notification on permission requests"
        },
        "zhanlu.notifications.errors": {
          "type": "boolean",
          "default": true,
          "description": "Show notification on errors"
        },
        "zhanlu.sounds.agent": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "none"
          ],
          "description": "Sound to play when agent completes"
        },
        "zhanlu.sounds.permissions": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "none"
          ],
          "description": "Sound to play on permission requests"
        },
        "zhanlu.sounds.errors": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "none"
          ],
          "description": "Sound to play on errors"
        }
      }
    }
  },
  "scripts": {
    "build": "bun script/build.ts",
    "prepare:cli-binary": "bun script/local-bin.ts",
    "compile": "bun run prepare:cli-binary && bun run rebuild-sdk && bun run typecheck && bun run lint && node esbuild.js",
    "watch": "bun run rebuild-sdk && bun run --parallel watch:esbuild watch:tsc",
    "watch:esbuild": "bun run prepare:cli-binary && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:cli": "bun script/watch-cli.ts",
    "package": "bun run prepare:cli-binary && bun run rebuild-sdk && bun run typecheck && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "check-types:webview": "bun script/typecheck.ts --project webview-ui/tsconfig.json",
    "typecheck": "bun run check-types:extension && bun run check-types:webview",
    "check-types:extension": "bun script/typecheck.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint src webview-ui",
    "test": "vscode-test",
    "test:unit": "bun test tests/unit/",
    "rebuild-sdk": "bun run --cwd ../sdk/js build",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build -o storybook-static",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@storybook/addon-docs": "10.2.10",
    "@types/diff": "^6.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.108.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "knip": "5.85.0",
    "prettier": "^3.8.1",
    "qrcode": "^1.5.4",
    "storybook": "10.2.10",
    "storybook-solidjs-vite": "10.0.9",
    "ts-morph": "27.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@kilocode/kilo-i18n": "workspace:*",
    "@kilocode/kilo-ui": "workspace:*",
    "@kilocode/sdk": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@thisbeyond/solid-dnd": "0.7.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "fastest-levenshtein": "^1.0.16",
    "ignore": "^7.0.3",
    "js-tiktoken": "^1.0.18",
    "lru-cache": "^11.0.2",
    "openai": "^4.85.4",
    "quick-lru": "^7.0.0",
    "simple-git": "3.31.1",
    "solid-js": "^1.9.11",
    "uri-js": "^4.4.1",
    "web-tree-sitter": "^0.24.7",
    "zod": "^3.24.2"
  }
}
